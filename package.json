{
  "name": "plotmatch",
  "version": "1.0.0",
  "private": true,
  "description": "Group-Aware Semantic Discovery for Movies & Books — DBMS mini project (MySQL + MongoDB Atlas Vector Search + Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "node scripts/setup-db.mjs",
    "db:mongo": "mongosh \"$MONGODB_URI\" db/mongo/01_create_collections.js",
    "db:rud": "mongosh \"$MONGODB_URI\" db/mongo/03_vector_rud.js",
    "embed": "node scripts/embed.mjs",
    "embed:stale": "node scripts/embed.mjs --stale-only"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "jose": "^5.9.6",
    "mongodb": "^6.10.0",
    "mysql2": "^3.11.4",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
