# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- MySQL -----------------------------------------------------------------
# Use the least-privileged account created by db/06_rbac_dcl.sql, not root.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=plotmatch_app
MYSQL_PASSWORD=TnOiHErlz7pgAIWajmZn5E
MYSQL_DATABASE=plotmatch

# Root credentials, used ONLY by `npm run db:setup` to build the schema.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# --- MongoDB ---------------------------------------------------------------
# Atlas:  mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/plotmatch
# Local:  mongodb://localhost:27017/plotmatch
MONGODB_URI=mongodb://localhost:27017/plotmatch
MONGODB_DB=plotmatch

# atlas = use $vectorSearch (needs an Atlas cluster + the vector_index)
# local = exact cosine similarity computed in Node; works on any MongoDB,
#         identical rankings at this catalogue size. Use this if Atlas is
#         unavailable on demo day.
VECTOR_BACKEND=local

# --- Auth ------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_before_running
SESSION_COOKIE=plotmatch_session
SESSION_TTL_HOURS=12

# --- Embeddings ------------------------------------------------------------
# Runs locally via @xenova/transformers. No API key, no network call after the
# first model download (~90 MB, cached in ./models).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
